# example of file for storing private and user specific environment variables, like keys or system paths
# rename it to ".env" (excluded from version control by default)
# .env is loaded by train.py and eval.py automatically

# HuggingFace user that owns the HOI datasets (used by the relationships task YAMLs)
HF_USERNAME=

# HOI dataset image directories (used by the relationships tasks)
HICODET_IMAGES_DIR=
VGHOI_IMAGES_DIR=

# HuggingFace configuration
HF_HOME=".cache/huggingface"
HF_TOKEN=
HF_TRUST_REMOTE_CODE=true
